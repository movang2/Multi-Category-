<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:padding="10dp">

    <!-- Header Section -->
    <LinearLayout
        android:id="@+id/header"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_alignParentTop="true"
        android:layout_alignParentLeft="true">
        
        <TextView
            android:id="@+id/widget_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⚡ Ghi chú nhanh"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="6dp"
            android:text=""
            android:textColor="#80D8FF"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Buttons Container on the Right -->
    <LinearLayout
        android:id="@+id/buttons_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentRight="true"
        android:layout_centerVertical="true"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <!-- Button to open list & manage reminders without opening app -->
        <LinearLayout
            android:id="@+id/btn_manage_container"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_marginRight="8dp"
            android:background="@drawable/widget_secondary_button_background"
            android:gravity="center">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔔"
                android:textSize="16sp" />
        </LinearLayout>

        <!-- Button to Add New Quick Note -->
        <LinearLayout
            android:id="@+id/btn_add_container"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/widget_button_background"
            android:gravity="center">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="+"
                android:textColor="#FFFFFF"
                android:textSize="22sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- Center content / Prompt or latest note preview text -->
    <TextView
        android:id="@+id/widget_prompt"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/header"
        android:layout_alignParentLeft="true"
        android:layout_toLeftOf="@id/buttons_container"
        android:layout_marginTop="6dp"
        android:layout_marginRight="8dp"
        android:text="🔒 Nội dung được bảo mật • Chạm để mở"
        android:textColor="#B3B3B3"
        android:textSize="12sp"
        android:maxLines="2"
        android:ellipsize="end" />

</RelativeLayout>
